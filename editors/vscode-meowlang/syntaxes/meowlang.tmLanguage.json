{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "meowlang",
  "scopeName": "source.meowlang",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "keywords": {
      "match": "\\b(purr|meow)\\b",
      "name": "keyword.control.meowlang"
    },
    "builtins": {
      "match": "\\byowl\\b",
      "name": "support.function.builtin.meowlang"
    },
    "strings": {
      "name": "string.quoted.double.meowlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\n|\\\\\"",
          "name": "constant.character.escape.meowlang"
        }
      ]
    },
    "numbers": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.meowlang"
    },
    "operators": {
      "match": "<=|>=|[-+*/=<>&|!]",
      "name": "keyword.operator.meowlang"
    },
    "punctuation": {
      "match": ":",
      "name": "punctuation.separator.colon.meowlang"
    },
    "identifiers": {
      "match": "[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.meowlang"
    }
  }
}
